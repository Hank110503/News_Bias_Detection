{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "War News Bias Analyzer",
  "version": "0.1.0",
  "identifier": "com.local.warnewsbias",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "战争新闻多模态偏见分析台",
        "width": 1440,
        "height": 960,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}

